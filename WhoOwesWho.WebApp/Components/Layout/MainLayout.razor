@using WhoOwesWho.WebApp.CoreBusiness.Entities.Alert
@using WhoOwesWho.WebApp.Services

@inherits LayoutComponentBase
@inject ICookieClientService _cookieClientService
@inject IAlertService _alertService
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col w-full">

    <!-- Topbar -->
    <div class="w-full">
        @if (!_isAuthorized)
        {
            <AnonymousNavMenu />
        }
        else
        {
            <AuthorizedNavMenu />
        }
    </div>

    <!-- Main content -->
    <main class="flex-grow w-full flex justify-center">
        <div class="w-full max-w-4xl px-4">
            <article class="content">
                @Body
            </article>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-100 w-full">
        <div class="w-full max-w-4xl mx-auto p-4 flex flex-col md:flex-row md:items-center md:justify-between">
            <span class="text-sm text-gray-500 text-center md:text-left">
                © 2024
                <a href="/" class="hover:underline">
                    WhoOwesWo™
                </a>
                . All Rights Reserved.
            </span>

            <ul class="flex flex-wrap justify-center md:justify-end items-center mt-3 text-sm font-medium text-gray-500 md:mt-0">
                <li>
                    <a href="/about" class="text-blue-500 hover:underline mr-4">
                        About
                    </a>
                </li>
                <li>
                    <a href="/privacy" class="text-blue-500 hover:underline">
                        Privacy Policy
                    </a>
                </li>
            </ul>
        </div>
    </footer>

</div>

@code {
    private bool _isAuthorized;

    protected override async Task OnInitializedAsync()
    {
        _alertService.OnShow += HandleAlert;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isAuthorized = await _cookieClientService.IsAuthorizedAsync();
            StateHasChanged();
        }
    }
    
    private async Task HandleAlert(AlertRequestModel request)
    {
        var result = await JS.InvokeAsync<SwalResult>(
            "blazorSwal.showAdvanced",
            request.Message,
            request.Type.ToString()
        );

        // Handle confirmation dialogs
        if (request.Completion != null)
        {
            request.Completion.SetResult(result.IsConfirmed);
        }
    }

    public class SwalResult
    {
        public bool IsConfirmed { get; set; }
    }
}