@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col w-full">

    <!-- Topbar -->
    <div class="w-full">
        @if (!isAuthorized)
        {
            <AnonymousNavMenu />
        }
        else
        {
            <AuthorizedNavMenu />
        }
    </div>

    <!-- Main content -->
    <main class="flex-grow w-full flex justify-center">
        <div class="w-full px-4">
            <article class="content">
                @Body
            </article>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-100 w-full">
        <div class="w-full max-w-4xl mx-auto p-4 flex flex-col md:flex-row md:items-center md:justify-between">
            <span class="text-sm text-gray-500 text-center md:text-left">
                © 2026
                <a href="/" class="hover:underline">
                    WhoOwesWo™
                </a>
                . All Rights Reserved.
            </span>

            <ul class="flex flex-wrap justify-center md:justify-end items-center mt-3 text-sm font-medium text-gray-500 md:mt-0">
                <li>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-blue-500 hover:underline mr-4">
                        About
                    </a>
                </li>
                <li>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-blue-500 hover:underline">
                        Privacy Policy
                    </a>
                </li>
            </ul>
        </div>
    </footer>

</div>