<!-- Components/Controls/ActionButton.razor -->
<button type="button"
        disabled="@IsProcessing"
        class="@GetCssClass()"
        @onclick="HandleClick">
        

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetCssClass() =>
        IsProcessing
          ? "bg-green-700  text-white font-extralight py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-default"
          : "bg-gray-700 hover:bg-green-700 text-white font-extralight py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer";

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}