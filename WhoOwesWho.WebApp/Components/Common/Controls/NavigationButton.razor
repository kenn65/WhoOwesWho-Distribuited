<!-- Components/Controls/NavigationButton.razor -->
@inject NavigationManager NavigationManager

<button type="button"
        disabled="@IsProcessing"
        class="@GetCssClass()"
        @onclick="HandleNavigation">

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public string NavigationUrl { get; set; } = "#";

    private bool IsProcessing;

    private string GetCssClass() =>
        IsProcessing
            ? "bg-green-700 text-white px-4 py-2 rounded cursor-default"
            : "bg-gray-700 hover:bg-green-700 text-white px-4 py-2 rounded cursor-pointer";

    private async Task HandleNavigation()
    {
        IsProcessing = true;
        StateHasChanged();
        await Task.Delay(50); 
        NavigationManager.NavigateTo(NavigationUrl);
    }
}