<!-- Components/Controls/NavigationButton.razor -->
@inject NavigationManager NavigationManager

<button type="button"
        disabled="@IsProcessing"
        class="@GetCssClass()"
        @onclick="HandleNavigation">

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public string NavigationUrl { get; set; } = "#";

    private bool IsProcessing;

    private string GetCssClass() => "bg-gray-700 hover:bg-black text-white font-extralight py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer w-full sm:w-auto";

    private async Task HandleNavigation()
    {
        IsProcessing = true;
        StateHasChanged();

        await Task.Delay(50);

        NavigationManager.NavigateTo(NavigationUrl);
    }
}