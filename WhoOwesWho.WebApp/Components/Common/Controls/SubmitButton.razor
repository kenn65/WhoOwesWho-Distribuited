<!-- Components/Controls/SubmitButton.razor -->

<button type="submit"
        disabled="@IsProcessing"
        class="@GetCssClass()">

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public bool IsProcessing { get; set; }

    private string GetCssClass() =>
        IsProcessing
            ? "bg-green-700 text-white px-4 py-2 rounded cursor-default w-full sm:w-auto"
            : "bg-gray-700 hover:bg-green-700 text-white px-4 py-2 rounded cursor-pointer w-full sm:w-auto";
}