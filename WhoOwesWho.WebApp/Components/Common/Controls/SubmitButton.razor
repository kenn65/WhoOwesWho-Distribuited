<!-- Components/Controls/SubmitButton.razor -->
<button type="submit"
        disabled="@IsProcessing"
        class="@GetCssClass()"
        @onclick="HandleClick"
        >

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";


    private bool IsProcessing;

    private string GetCssClass() =>
        IsProcessing
            ? "bg-green-700 text-white px-4 py-2 rounded cursor-default"
            : "bg-gray-700 hover:bg-green-700 text-white px-4 py-2 rounded cursor-pointer";

    private async Task HandleClick()
    {
        IsProcessing = true;
        StateHasChanged();
        await Task.Delay(50); // yield to renderer before navigating
    }
}