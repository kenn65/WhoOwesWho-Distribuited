<div class="text-center">
    <br />
    <br />
    <h1 class="text-4xl">My workspace</h1>
    <br />
    <h3 class="text-xl">Events</h3>
    <br />
    <p class="text-xs">Assign to an event to handle credits and debits</p>
    <br />
    <br />
    <EditForm method="post" Model="@EventAssignmentRequestModel" OnValidSubmit="HandleSubmit" FormName="eventassignment" Enhance>
        <EventSelectElement Id="event"
                            Caption="Event:"
                            Value="@EventAssignmentRequestModel!.EventId"
                            ValueChanged="@(v => EventAssignmentRequestModel.EventId = v)"
                            ValueExpression="@(() => EventAssignmentRequestModel.EventId)" 
                            EventList="EventList"/>
                            
        <br />
        <br />
        <SubmitButton Text="Submit"
                      ProcessingText="Processing..." IsProcessing="IsProcessing" />
            </EditForm>
</div>




