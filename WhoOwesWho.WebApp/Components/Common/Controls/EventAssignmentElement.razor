<EditForm method="post" Model="@EventAssignmentRequestModel" OnValidSubmit="HandleSubmit" FormName="eventassignment" Enhance>
    <EventSelectElement Id="event"
                        Caption="Event:"
                        Value="@EventAssignmentRequestModel!.EventIdString"
                        ValueChanged="@(v => EventAssignmentRequestModel.EventIdString = v)"
                        ValueExpression="@(() => EventAssignmentRequestModel.EventIdString)"
                        EventList="EventList" />

    <br />
    <br />
    <SubmitButton Text="Submit"
                  ProcessingText="Processing..." IsProcessing="IsProcessing" />
</EditForm>





