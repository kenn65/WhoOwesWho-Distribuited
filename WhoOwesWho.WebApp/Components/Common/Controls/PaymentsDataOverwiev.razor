@inject IStateHandler<PaymentStateModel> PaymentsState
@inject NavigationManager NavigationManager

<div>
    <p class="text-2xl text-blue-800">
        @PaymentsData.Event?.Name @PaymentsData.Event?.Location started at @PaymentsData.Event?.StartDateIso
    </p>
    <br />
    <br />
    <hr />
    <br />
    <p class="text-xl">Settlement</p>
    <br />
    @foreach (var item in PaymentsData.WhoOwesWho!)
    {
        <p>
            <span class="p-2">
                <span class="pr-2">Who:</span>
                <input type="text"
                       value=@item.DebitorName
                       readOnly
                       class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-1/6" />
            </span>
            <span class="p-2">
                <span class="pr-2">Owes:</span>
                <input type="text"
                       readOnly
                       value="@($"{item.FormattedAmount} {PaymentsData.Event!.CurrencySymbol}")"
                       class="shadow appearance-none border border-gray-700 hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-1/6 text-right" />
            </span>
            <span class="p-2">
                <span class="pr-2">Who:</span>
                <input type="text"
                       readOnly
                       value=@item.CreditorName
                       class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-1/6" />
            </span>

        </p>
    }
    <br />
    <br />
    <hr />
    <br />
    <p class="text-xl">Balances</p>
    <br />
    <QuickGrid Items="@PaymentsData.Balances!.AsQueryable()" class="m-auto">
        <PropertyColumn Property="@(e => e.User!.FullName)" Title="User" Class="p-3" />
        <PropertyColumn Property="@(e => e.User!.MobilePhoneNumber)" Title="Mobile" Class="p-3" />
        <TemplateColumn Title=@($"Balance ({PaymentsData.Event!.CurrencySymbol})") Class="p-3">
            <div class="text-right mr-[26px]">
                @context.FormattedBalance
            </div>
        </TemplateColumn>
    </QuickGrid>
    <br />
    <br />
    <hr />
    <br />
    <p class="text-xl">Payments</p>
    <br />
    <QuickGrid Items="@PaymentsData!.Payments!.AsQueryable()" class="m-auto">
        <PropertyColumn Property="@(e => e.CreditEventUser!.FullName)" Title="Creditor" Class="p-3" />
        <PropertyColumn Property="@(e => e.DebitEventUser!.FullName)" Title="Debtor" Class="p-3" />
        <TemplateColumn Title=@($"Amount ({PaymentsData.Event!.CurrencySymbol})") Class="p-3">
            <div class="text-right mr-[26px]">
                <a href="javascript:void(0)"
                   @onclick="() => GotoDetailsAsync(context)"
                   class="text-blue-500 hover:underline">
                    @context.FormattedAmount
                </a>
            </div>
        </TemplateColumn>
        <PropertyColumn Property="@(e => e.Description)" Title="Description" Class="p-3" />
        <PropertyColumn Property="@(e => e.Created)" Title="Created" Class="p-3" />
    </QuickGrid>
    
</div>

@code {
    [Parameter] public PaymentsResponseModel PaymentsData { get; set; } = default!;
    [Parameter] public bool Active { get; set; }

    private async Task GotoDetailsAsync(UserPaymentResponseModel context)
    {
        PaymentsState.SelectedItem = new PaymentStateModel()
        {
            PaymentId = context.Id,
            CreditUserId = context.CreditEventUser!.Id,
            Active = Active
        };
        NavigationManager.NavigateTo("/me/payment/details");
    }
}
