<!-- Components/Controls/NavigationStateButton.razor -->
@inject NavigationManager NavigationManager

<button type="button"
        disabled="@IsProcessing"
        class="@GetCssClass()"
        @onclick="HandleClick">

    @(IsProcessing ? ProcessingText : Text)

</button>

@code {
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsProcessing;

    private string GetCssClass() => "bg-gray-700 hover:bg-black text-white font-extralight py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer";
           

    private async Task HandleClick()
    {
        IsProcessing = true;
        StateHasChanged();
        await Task.Delay(50);
        await OnClick.InvokeAsync();
    }
}
