@page "/me/workspace"

@if (EventUserAssignmentResponseModel == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}

@if (EventUserAssignmentResponseModel != null && !HasAssignment)
{
    <EventAssignmentElement IsProcessing="@IsProcessing"
                            EventList="@EventResponseModels"
                            HandleAssign="@OnAssignAsync" />
}
@if (EventUserAssignmentResponseModel != null && HasAssignment)
{
    <EventPaymentElement HasAssignment="@HasAssignment"
                         HasPayments="@HasPayments"
                         IsProcessing="@IsProcessing"
                         EventResponseModel="@EventResponseModel"
                         CurrencyList="@Currencies"
                         UserBalanceResponseModel="@UserBalanceResponseModel"
                         HandleUnassign="@OnUnassignAsync"
                         HandlePayment="@OnPaymentAsync"
                         />
}



