@page "/me/payments"
@inherits AuthorizationComponentBase
@if (isLoading)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <h1 class="text-4xl">Payments owerview</h1>
        <br />
        <br />
        @if (payments?.Payments == null)
        {
            <p class="text-base">No active payments available for this event!</p>
        }
        else
        {
            <PaymentsDataOverwiev PaymentsData="@payments"
                                  Active="@true" />
            <br />
            <br />
            @if (isAdministrator)
            {
                <EditForm method="post" Model="settleEventRequestModel" OnSubmit="SettleEventAsync" FormName="settlement" Enhance>
                    <SubmitButton IsProcessing="@isProcessing"
                                  Text="Close event"
                                  ProcessingText="Processing" />
                </EditForm>
            }
        }
    </div>
}



