@page "/me/profile"

@if (UserProfileResponseModel == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">My profile</h1>
        <br />
        <br />
        <p class="text-xl">
            Edit full name, mobile phone number, <a href="/me" class="text-blue-600 underline">administrator</a> or change password.
        </p>
        <br />
        <br />
        <EditForm method="post" Model="@UserProfileResponseModel" OnValidSubmit="HandleSubmit" FormName="myprofile" Enhance>
            <DataAnnotationsValidator />
            <TextElement Id="   name"
                         Caption="Name:"
                         Placeholder="Your first and last name or some other unique nickname"
                         Value="@UserProfileResponseModel!.FullName"
                         ValueChanged="@(v => UserProfileResponseModel.FullName = v)"
                         ValueExpression="@(() => UserProfileResponseModel.FullName)" />
            <br />
            <br />
            <TextElement Id="mobile"
                         Caption="Mobile phone number:"
                         Placeholder="Your mobile phone number"
                         Value="@UserProfileResponseModel.MobilePhoneNumber"
                         ValueChanged="@(v => UserProfileResponseModel.MobilePhoneNumber = v)"
                         ValueExpression="@(() => UserProfileResponseModel.MobilePhoneNumber)" />
            <br />
            <br />
            <TextElement Id="mobile"
                         Caption="Email address:"
                         Value="@UserProfileResponseModel.EmailAddress"
                         ValueChanged="@(v => UserProfileResponseModel.EmailAddress = v)"
                         ValueExpression="@(() => UserProfileResponseModel.EmailAddress)"
                         readonly />
            <br />
            <br />
            <label for="administrator" class="form-label">Administrator:</label>
            <br />
            <InputCheckbox id="administrator" @bind-Value="UserProfileResponseModel.Admin" class="tshadow border border-gray-700 hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-16" />
            <br />
            <br />
            <span class="p-2">
                <SubmitButton Text="Submit"
                              ProcessingText="Processing..."
                              IsProcessing="IsProcessing" />
            </span>
            <span class="p-2">
                <NavigationButton Text="Change password"
                                  ProcessingText="Navigating..."
                                  NavigationUrl="/me/profile/password" />
            </span>
            <span class="p-2">
                <ActionButton Text="Cancel"
                              ProcessingText="Cancellig..."
                              NavigationUrl="/me" ForceLoad="true" />
            </span>
        </EditForm>
    </div>
}