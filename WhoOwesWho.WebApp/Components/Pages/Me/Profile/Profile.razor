@page "/me/profile"


@inject NavigationManager _nav
@inject ICookiesMasterService _cookiesMasterService
@inject IUserUseCase _userUseCase
@inject IEventsUseCase _eventsUseCase
@inject IAlertService _alertService

@if (UserModel == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-700"></div>
    </div>
}
else
{
    <div class="text-center mb-2">
        <br />
        <br />
        <h1 class="text-4xl">My profile</h1>
        <br />
        <br />
        <p class="text-xl">
            Edit full name, mobile phone number, <a href="/me" class="text-blue-600 underline">administrator</a> or change password.
        </p>
        <br />
        <br />
        <EditForm method="post" Model="@UserModel" OnSubmit="HandleSubmit" FormName="myprofile" Enhance>
            <DataAnnotationsValidator />
            <TextElement Id="fullname"
                         Caption="Full Name:"
                         Value="@UserModel!.FullName"
                         ValueChanged="@(v => UserModel.FullName = v)"
                         ValueExpression="@(() => UserModel.FullName)" />
            <br />
            <br />
            <TextElement Id="mobile"
                         Caption="Mobile phone number:"
                         Value="@UserModel.MobilePhoneNumber"
                         ValueChanged="@(v => UserModel.MobilePhoneNumber = v)"
                         ValueExpression="@(() => UserModel.MobilePhoneNumber)" />
            <br />
            <br />
            <TextElement Value="@UserModel.EmailAddress"
                         ValueChanged="@(v => UserModel.EmailAddress = v)"
                         ValueExpression="@(() => UserModel.EmailAddress)"
                         Id="mobile"
                         Caption="Email address:"
                         readonly />
            <br />
            <br />
            <label for="administrator" class="form-label">Administrator:</label>
            <br />
            <InputCheckbox id="administrator" @bind-Value="UserModel.Admin" class="tshadow border border-gray-700 hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-16" />
            <br />
            <br />
            <SubmitButton Text="Update" ProcessingText="Processing..." IsProcessing="IsProcessing" />
            &nbsp;&nbsp;&nbsp;
            <NavigationButton Text="Change password" ProcessingText="Navigating..." NavigationUrl="/me/profile/password" />
            &nbsp;&nbsp;&nbsp;
            <ActionButton Text="Cancel" ProcessingText="Cancellig..." NavigationUrl="/me" ForceLoad="true" />
        </EditForm>
    </div>
}

@code {

    [SupplyParameterFromForm]
    public UserModel? UserModel { get; set; }

    private bool IsProcessing = false;
    private CookiesResponseModel? Cookies = null;

    protected override async Task OnInitializedAsync()
    {
        Cookies = await _cookiesMasterService.GetAsync();
        UserModel = await GetUserAsync();
    }

    private async Task<UserModel> GetUserAsync()
    {
        return await _userUseCase.ExecuteAsync(Cookies!.UserIdValue, Cookies.TokenValue, false);
    }

    private async Task HandleSubmit()
    {
        IsProcessing = true;
        var eventId = (await _eventsUseCase.ExecuteAsync(Cookies!.UserIdValue, Cookies.TokenValue)).EventId.ToString();
        var requestModel = new UserUpdateRequestModel
        {
            ProtectedId = Cookies.UserIdValue,
            FullName = UserModel?.FullName!,
            MobilePhoneNumber = UserModel?.MobilePhoneNumber!,
            Admin = UserModel!.Admin,
            EventId = eventId
        };
        var response = await _userUseCase.ExecuteAsync(Cookies.UserIdValue, Cookies.TokenValue, requestModel);
        await StopProcessing();
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/me/profile", true);
            return;
        }
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/me/profile", true);
    }

    private async Task StopProcessing()
    {
        IsProcessing = false;
        StateHasChanged();
        await Task.Yield();
    }
}
