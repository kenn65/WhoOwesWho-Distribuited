@page "/me/events"

@if (EventList == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">Events</h1>
        <br />
        <br />
        @if (IsAdmin)
        {
            <p class="text-xl">My events </p>
        }
        else
        {
            <p class="text-xl">Active events list</p>
        }
        <br />
        <br />
        @if (IsAdmin)
        {
            <NavigationButton Text="Create new event"
                              ProcessingText="Navigating..."
                              NavigationUrl="/me/events/create" />
        }
        <br />
        <br />
        <QuickGrid Items="@EventList.AsQueryable()" class="m-auto">

            <PropertyColumn Property="@(e => e.Name)" Title="Name" Class="p-6" />
            <PropertyColumn Property="@(e => e.Location)" Title="Location" Class="p-6" />
            <PropertyColumn Property="@(e => e.Currency)" Title="Currency" Class="p-6" />
            <PropertyColumn Property="@(e => e.StartDateIso)" Title="Start Date" Class="p-6" />
            <PropertyColumn Property="@(e => e.CreatedBy)" Title="Created By" Class="p-6" />

            <!-- Active column -->
            <TemplateColumn Title="Active" Class="p-6">
                <span class="@(context.Settled ? "text-red-600" : "text-green-600")">
                    @context.ActiveIcon
                </span>
            </TemplateColumn>

            <!-- Actions -->
            @if (IsAdmin)
            {
                <TemplateColumn Title="Actions" Class="p-2">
                    @if (!context.Settled)
                    {
                        <span class="p-2">
                            <NavigationStateButton Text="Edit"
                                                   ProcessingText="Navigating..."
                                                   OnClick="() => EditEventAsync(context.Adapt<EventModel>())" />
                        </span>
                        <span class="p-2">
                            <NavigationStateButton Text="Delete"
                                                   ProcessingText="Navigating..."
                                                   OnClick="() => DeleteEventAsync(context.Adapt<EventModel>())" />
                        </span>
                    }
                </TemplateColumn>
            }

        </QuickGrid>
        <br />
        <br />
    </div>
}