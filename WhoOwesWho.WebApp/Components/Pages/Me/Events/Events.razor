@page "/me/events"

@if (EventList == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">Events</h1>
        <br />
        <br />
        <p class="text-xl">Active events list</p>
        <br />
        <br />
        @if (IsAdmin)
        {
            <NavigationButton Text="Create new event"
                              ProcessingText="Navigating..."
                              NavigationUrl="/me/events/create" />
        }
        <br />
        <br />
        <table class="justify-center m-auto">
            <thead>
                <tr>
                    <th class="p-6">Name</th>
                    <th class="p-6">Location</th>
                    <th class="p-6">Currency</th>
                    <th class="p-6">Start Date</th>
                    <th class="p-6">Created By</th>
                    <th class="p-6">Active</th>
                    @if (IsAdmin)
                    {
                        <th class="p-6">Actions</th>                
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (EventResponseModel item in EventList)
                {
                    <tr>
                        <td class="p-6">@item.Name</td>
                        <td class="p-6">@item.Location</td>
                        <td class="p-6">@item.Currency</td>
                        <td class="p-6">@item.StartDateIso </td>
                        <td class="p-6">@item.CreatedBy </td>
                        <td class="p-6">
                            <span class="@(item.Settled ? "text-red-600" : "text-green-600")">
                                @item.ActiveIcon
                            </span>
                        </td>

                        @if (IsAdmin)
                        {
                            <td class="p-2">
                                <NavigationStateButton Text="Edit"
                                                       ProcessingText="Navigating..."
                                                       OnClick="() => EditEventAsync(item.Adapt<EventModel>())" />
                            </td>

                            <td class="p-2">
                                <NavigationStateButton Text="Delete"
                                                       ProcessingText="Navigating..."
                                                       OnClick="() => DeleteEventAsync(item.Adapt<EventModel>())" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <br />
        <br />
    </div>
}