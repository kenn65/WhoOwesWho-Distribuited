@page "/me/events"
@inherits AuthorizationComponentBase

@if (isLoading)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <div class="text-center mb-8">
            <h1 class="text-2xl md:text-3xl lg:text-4xl font-semibold mb-4">
                Events
            </h1>

            <p class="text-base md:text-lg lg:text-xl">
                @(isAdministrator ? "My events" : "Active events list")
            </p>
        </div>

        @if (isAdministrator)
        {
            <div class="flex justify-center mb-6">
                <NavigationButton Text="Create new event"
                                  ProcessingText="Navigating..."
                                  NavigationUrl="/me/events/create" />
            </div>
        }

        <!-- MOBILE -->
        <div class="md:hidden">
            <div class="space-y-4">

                @foreach (var eventItem in eventList!)
                {
                    <div class="bg-white rounded-lg shadow border p-4">

                        <div class="mb-3">
                            <h2 class="font-semibold text-lg">
                                @eventItem.Name
                            </h2>
                        </div>

                        <div class="space-y-2 text-sm">

                            <div class="flex justify-between">
                                <span class="font-medium">Location</span>
                                <span>@eventItem.Location</span>
                            </div>

                            <div class="flex justify-between">
                                <span class="font-medium">Currency</span>
                                <span>@eventItem.Currency</span>
                            </div>

                            <div class="flex justify-between">
                                <span class="font-medium">Start Date</span>
                                <span>@eventItem.StartDateIso</span>
                            </div>

                            <div class="flex justify-between">
                                <span class="font-medium">Created By</span>
                                <span>@eventItem.CreatedBy</span>
                            </div>

                            <div class="flex justify-between">
                                <span class="font-medium">Active</span>

                                <span class="@(eventItem.Settled ? "text-red-600" : "text-green-600")">
                                    @eventItem.ActiveIcon
                                </span>
                            </div>

                        </div>

                        @if (isAdministrator && !eventItem.Settled)
                        {
                            <div class="mt-4 flex flex-col gap-2">

                                <NavigationStateButton Text="Edit"
                                                       ProcessingText="Navigating..."
                                                       OnClick="() => EditEventAsync(eventItem.Adapt<EventModel>())" />

                                @if (!eventItem.Users!.Any())
                                {
                                    <NavigationStateButton Text="Delete"
                                                           ProcessingText="Processing..."
                                                           OnClick="() => DeleteEventAsync(eventItem.Adapt<EventModel>())" />
                                }
                                else
                                {
                                    <input type="button"
                                           disabled
                                           value="Delete"
                                           class="bg-gray-500 text-white py-2 px-4 rounded cursor-not-allowed" />
                                }

                            </div>
                        }

                    </div>
                }

            </div>
        </div>

        <!-- TABLET + DESKTOP -->
        <div class="hidden md:block overflow-x-auto">

            <QuickGrid Items="@eventList!.AsQueryable()"
                       class="w-full">

                <PropertyColumn Property="@(e => e.Name)"
                                Title="Name"
                                Class="p-2 md:p-4 text-center" />

                <PropertyColumn Property="@(e => e.Location)"
                                Title="Location"
                                Class="p-2 md:p-4 text-center" />

                <PropertyColumn Property="@(e => e.Currency)"
                                Title="Currency"
                                Class="p-2 md:p-4 text-center" />

                <PropertyColumn Property="@(e => e.StartDateIso)"
                                Title="Start Date"
                                Class="p-2 md:p-4 text-center" />

                <PropertyColumn Property="@(e => e.CreatedBy)"
                                Title="Created By"
                                Class="p-2 md:p-4 text-center" />

                <TemplateColumn Title="Active"
                                Class="p-2 md:p-4 text-center">
                    <span class="@(context.Settled
                                                  ? "text-red-600"
                                                  : "text-green-600")">
                        @context.ActiveIcon
                    </span>
                </TemplateColumn>

                @if (isAdministrator)
                {
                    <TemplateColumn Title="Actions"
                                    Class="p-2 md:p-4 text-center">

                        @if (!context.Settled)
                        {
                            <div class="flex justify-center gap-2">

                                <NavigationStateButton Text="Edit"
                                                       ProcessingText="Navigating..."
                                                       OnClick="() => EditEventAsync(context.Adapt<EventModel>())" />

                                @if (!context.Users!.Any())
                                {
                                    <NavigationStateButton Text="Delete"
                                                           ProcessingText="Processing..."
                                                           OnClick="() => DeleteEventAsync(context.Adapt<EventModel>())" />
                                }
                                else
                                {
                                    <input type="button"
                                           disabled
                                           value="Delete"
                                           class="bg-gray-500 text-white py-2 px-4 rounded cursor-not-allowed" />
                                }

                            </div>
                        }

                    </TemplateColumn>
                }

            </QuickGrid>

        </div>

    </div>
}