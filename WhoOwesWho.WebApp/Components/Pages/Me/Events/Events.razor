@page "/me/events"
@inherits AuthorizationComponentBase
@if (isLoading)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">Events</h1>
        <br />
        <br />
        @if (isAdministrator)
        {
            <p class="text-xl">My events </p>
        }
        else
        {
            <p class="text-xl">Active events list</p>
        }
        <br />
        <br />
        @if (isAdministrator)
        {
            <NavigationButton Text="Create new event"
                              ProcessingText="Navigating..."
                              NavigationUrl="/me/events/create" />
            <br />
            <br />
        }
        <QuickGrid Items="@eventList!.AsQueryable()" class="m-auto">

            <PropertyColumn Property="@(e => e.Name)" Title="Name" Class="p-6 text-center" />
            <br />
            <PropertyColumn Property="@(e => e.Location)" Title="Location" Class="p-6 text-center" />
            <br />
            <PropertyColumn Property="@(e => e.Currency)" Title="Currency" Class="p-6 text-center" />
            <br />
            <PropertyColumn Property="@(e => e.StartDateIso)" Title="Start Date" Class="p-6 text-center" />
            <br />
            <PropertyColumn Property="@(e => e.CreatedBy)" Title="Created By" Class="p-6 text-center" />

            <!-- Active column -->
            <TemplateColumn Title="Active" Class="p-6 text-center">
                <span class="@(context.Settled ? "text-red-600" : "text-green-600")">
                    @context.ActiveIcon
                </span>
            </TemplateColumn>

            <!-- Actions -->
            @if (isAdministrator)
            {
                <TemplateColumn Title="Actions" Class="p-2 text-center">
                    @if (!context.Settled)
                    {
                        <span class="p-2">
                            <NavigationStateButton Text="Edit"
                                                   ProcessingText="Navigating..."
                                                   OnClick="() => EditEventAsync(context.Adapt<EventModel>())" />
                        </span>
                        @if (!context.Users!.Any())
                        {
                            <span class="p-2 text-center">
                                <NavigationStateButton Text="Delete"
                                                       ProcessingText="Navigating..."
                                                       OnClick="() => DeleteEventAsync(context.Adapt<EventModel>())" />
                            </span>
                        }
                        else
                        {
                            <span class="p-2 text-center">
                                <input type="button" disabled value="Delete" class="bg-gray-500 text-white font-extralight py-2 px-4 rounded focus:outline-none focus:shadow-outline" />
                            </span>
                        }
                    }
                </TemplateColumn>
            }

        </QuickGrid>
        <br />
        <br />
    </div>
}