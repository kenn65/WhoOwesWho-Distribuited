@page "/me/events/create"

@if (CurrencyList == null || EventRequestModel?.CreatedBy == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">Event</h1>
        <br />
        <br />
        <p class="text-xl">Create new event</p>
        <br />
        <br />
        <EditForm method="post" Model="@EventRequestModel" OnValidSubmit="HandleSubmit" FormName="newevent" Enhance>
            <DataAnnotationsValidator />
            <TextElement Value="@EventRequestModel!.Name"
                         ValueChanged="@(v => EventRequestModel.Name = v)"
                         ValueExpression="@(() => EventRequestModel.Name)"
                         Id="name"
                         Caption="Name:"
                         Placeholder="Enter the event name" />
            <br />
            <br />
            <TextElement Id="location"
                         Caption="Location:"
                         Placeholder="Enter the event location"
                         Value="@EventRequestModel!.Location"
                         ValueChanged="@(v => EventRequestModel.Location = v)"
                         ValueExpression="@(() => EventRequestModel.Location)" />
            <br />
            <br />
            <CurrencySelectElement Id="currency"
                                   Caption="Currency:"
                                   Value="@EventRequestModel.Currency"
                                   ValueChanged="@(v=> EventRequestModel.Currency = v)"
                                   ValueExpression="@(() => EventRequestModel.Currency)"
                                   CurrencyList="@CurrencyList" />
            <br />
            <br />
            <div class="w-2/4 mx-auto text-left -mb-8">
                <label for="startDate" class="form-label">Start date:</label>
                <br />
                <InputDate id="startDate" @bind-Value="EventRequestModel!.StartDateDate" @attributes="dateAttributes" placeholder="Select start date" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-full" />
            </div>
            <br />
            <br />
            <TextElement Value="@EventRequestModel!.CreatedBy"
                         ValueChanged="@(v => EventRequestModel.CreatedBy = v)"
                         ValueExpression="@(() => EventRequestModel.CreatedBy)"
                         Id="createdby"
                         Caption="Created by:"
                         readonly />
            <br />
            <br />
            <label for="autoAssign" class="form-label">Assign yourself to this event:</label>
            <br />
            <InputCheckbox id="autoAssign" @bind-Value="EventRequestModel.AutoAssign" class="tshadow border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-16" />
            <br />
            <br />
            <span class="p-2">
                <SubmitButton Text="Submit"
                              ProcessingText="Processing..."
                              IsProcessing="IsProcessing" />
            </span>
            <span class="p-2">
                <ActionButton Text="Cancel"
                              ProcessingText="Cancelling..."
                              NavigationUrl="/me/events"
                              ForceLoad="true" />
            </span>
        </EditForm>
    </div>
}