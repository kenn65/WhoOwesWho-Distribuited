@page "/me/events/edit"

@if (EventResponseModel == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center mb-3">
        <br />
        <br />
        <h1 class="text-4xl">Event details</h1>
        <br />
        <br />
        <p class="text-xl">Update event</p>
        <br />
        <br />
        <EditForm method="post" Model="@EventResponseModel" OnValidSubmit="HandleSubmit" FormName="newevent" Enhance>
            <DataAnnotationsValidator />
            <TextElement Id="name"
                         Caption="Name:"
                         Placeholder="Enter the event name"
                         Value="@EventResponseModel!.Name"
                         ValueChanged="@(v => EventResponseModel.Name = v)"
                         ValueExpression="@(() => EventResponseModel.Name)" />
            <br />
            <br />
            <TextElement Id="location"
                         Caption="Location:"
                         Placeholder="Enter the event location"
                         Value="@EventResponseModel!.Location"
                         ValueChanged="@(v => EventResponseModel.Location = v)"
                         ValueExpression="@(() => EventResponseModel.Location)" />

            <br />
            <br />
            <CurrencySelectElement Id="currency"
                                   Caption="Currency:"
                                   Value="@EventResponseModel.Currency"
                                   ValueChanged="@(v=> EventResponseModel.Currency = v)"
                                   ValueExpression="@(() => EventResponseModel.Currency)"
                                   CurrencyList="@CurrencyList" />
            <br />
            <br />
            <div class="w-2/4 mx-auto text-left -mb-8">
                <label for="startDate" class="form-label">Start date:</label>
                <br />
                <InputDate id="startDate" @bind-Value="EventResponseModel!.StartDateDate" @attributes="_dateAttributes" placeholder="Select start date" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-full" />
            </div>
            <br />
            <br />
            <TextElement Value="@EventResponseModel!.CreatedBy"
                         ValueChanged="@(v => EventResponseModel.CreatedBy = v)"
                         ValueExpression="@(() => EventResponseModel.CreatedBy)"
                         Id="createdby"
                         Caption="Created by:"
                         readonly />
            <br />
            <br />
            <span class="p-2">
                <SubmitButton Text="Submit"
                              ProcessingText="Processing..."
                              IsProcessing="IsProcessing" />
            </span>
            <span class="p-2">
                <ActionButton Text="Cancel"
                              ProcessingText="Cancelling..."
                              NavigationUrl="/me/events" />
            </span>

        </EditForm>
    </div>
}