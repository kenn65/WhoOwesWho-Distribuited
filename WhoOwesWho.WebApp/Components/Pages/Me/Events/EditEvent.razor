@page "/me/events/edit"
@inherits AuthorizationComponentBase

@if (EventResponseModel == null)
{
    <div class="flex justify-center items-center h-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-green-700"></div>
    </div>
}
else
{
    <div class="text-center px-4 mb-3">

        <div class="my-6 md:my-10">
            <h1 class="text-2xl md:text-4xl">
                Event details
            </h1>

            <p class="text-lg md:text-xl mt-4">
                Update event
            </p>
        </div>

        <EditForm method="post"
                  Model="@EventResponseModel"
                  OnValidSubmit="HandleSubmit"
                  FormName="newevent"
                  Enhance>

            <DataAnnotationsValidator />

            <!-- Name -->
            <div class="mb-6">
                <TextElement Id="name"
                             Caption="Name:"
                             Placeholder="Enter the event name"
                             Value="@EventResponseModel.Name"
                             ValueChanged="@(v => EventResponseModel.Name = v)"
                             ValueExpression="@(() => EventResponseModel.Name)" />
            </div>

            <!-- Location -->
            <div class="mb-6">
                <TextElement Id="location"
                             Caption="Location:"
                             Placeholder="Enter the event location"
                             Value="@EventResponseModel.Location"
                             ValueChanged="@(v => EventResponseModel.Location = v)"
                             ValueExpression="@(() => EventResponseModel.Location)" />
            </div>

            <!-- Currency -->
            <div class="mb-6">
                <CurrencySelectElement Id="currency"
                                       Caption="Currency:"
                                       Value="@EventResponseModel.Currency"
                                       ValueChanged="@(v => EventResponseModel.Currency = v)"
                                       ValueExpression="@(() => EventResponseModel.Currency)"
                                       CurrencyList="@currencyList" />
            </div>

            <!-- Start Date -->
            <div class="w-full md:w-2/4 mx-auto text-left mb-6 px-1 md:px-0">
                <label for="startDate" class="form-label">
                    Start date:
                </label>

                <InputDate id="startDate"
                           @bind-Value="EventResponseModel.StartDateDate"
                           @attributes="DateAttributes"
                           placeholder="Select start date"
                           class="shadow appearance-none border border-gray-700 hover:border-green-700 rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline w-full" />
            </div>

            <!-- Created By -->
            <div class="mb-8">
                <TextElement Id="createdby"
                             Caption="Created by:"
                             Value="@EventResponseModel.CreatedBy"
                             ValueChanged="@(v => EventResponseModel.CreatedBy = v)"
                             ValueExpression="@(() => EventResponseModel.CreatedBy)"
                             readonly />
            </div>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-4">

                <SubmitButton Text="Submit"
                              ProcessingText="Processing..."
                              IsProcessing="isProcessing" />

                <ActionButton Text="Cancel"
                              ProcessingText="Cancelling..."
                              NavigationUrl="/me/events" />

            </div>

        </EditForm>

    </div>
}