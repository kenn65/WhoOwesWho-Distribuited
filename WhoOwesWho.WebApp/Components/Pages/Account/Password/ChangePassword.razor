@page "/me/profile/password"

@inject NavigationManager _nav
@inject ICookiesMasterService _cookiesMasterService
@inject IAlertService _alertService
@inject IUserUseCase _userUseCase


<div class="text-center">
      <br />
      <br />
      <h1 class="text-4xl">My profile</h1>
      <br />
      <br />
      <p class="text-xl">Change your password</p>
      <br />
      <br />
    <EditForm method="post" Model="@ChangePasswordRequestModel" OnValidSubmit="HandleSubmit" FormName="changepassword" Enhance>
        <DataAnnotationsValidator />
        <label for="password" class="form-label">Existing password:</label>
        <br />
        <InputText id="password" type="password" @bind-Value="ChangePasswordRequestModel!.Password" placeholder="Your existing password containing at least 8 characters, one upper case character and two digit" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => ChangePasswordRequestModel.Password)" class="text-danger" />
        <br />
        <br />
        <label for="newpassword1" class="form-label">New password:</label>
        <br />
        <InputText id="newpassword1" type="password" @bind-Value="ChangePasswordRequestModel.NewPassword1" placeholder="Your existing password containing at least 8 characters, one upper case character and two digit" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => ChangePasswordRequestModel.NewPassword1)" class="text-danger" />
        <br />
        <br />
        <label for="newpassword2" class="form-label">Repeat New Password:</label>
        <br />
        <InputText id="newpassword2" type="password" @bind-Value="ChangePasswordRequestModel.NewPassword2" placeholder="Your existing password containing at least 8 characters, one upper case character and two digit" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => ChangePasswordRequestModel.NewPassword2)" class="text-danger" />
        <br />
        <br />
        <SubmitButton Text="Submit" ProcessingText="Processing..." />
        &nbsp;&nbsp;&nbsp;
        <ActionButton Text="Cancel" ProcessingText="Cancelling..." NavigationUrl="/me/profile" ForceLoad="true" />

    </EditForm>
</div>



@code {

    [SupplyParameterFromForm]
    public ChangePasswordRequestModel? ChangePasswordRequestModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ChangePasswordRequestModel ??= new ChangePasswordRequestModel();
    }

    private async Task HandleSubmit()
    {
        var cookies = await _cookiesMasterService.GetAsync();
        ChangePasswordRequestModel!.EmailAddress = cookies!.UserEmailAddressValue;
        var response = await _userUseCase.ExecuteAsync(cookies.TokenValue, ChangePasswordRequestModel!);
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/me/profile/password", true);
            return;
        }
        await _cookiesMasterService.DeleteCookiesAsync();
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/account/signin", true);
    }

}
