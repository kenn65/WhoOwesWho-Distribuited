@page "/me/profile/password"

@inject NavigationManager _nav
@inject ICookiesMasterService _cookiesMasterService
@inject IAlertService _alertService
@inject IUserUseCase _userUseCase


<div class="text-center mb-3">
    <br />
    <br />
    <h1 class="text-4xl">My profile</h1>
    <br />
    <br />
    <p class="text-xl">Change your password</p>
    <br />
    <br />
    <EditForm method="post" Model="@ChangePasswordRequestModel" OnValidSubmit="HandleSubmit" FormName="changepassword" Enhance>
        <DataAnnotationsValidator />
        <TextElement Id="password"
                     Type="password"
                     Caption="Your existing password:"
                     Placeholder="Your existing password containing at least 8 characters, one upper case character and two digits"
                     Value="@ChangePasswordRequestModel!.Password"
                     ValueChanged="@(v => ChangePasswordRequestModel.Password = v)"
                     ValueExpression="@(() => ChangePasswordRequestModel!.Password)" />
        <br />
        <br />
        <TextElement Id="newpassword1"
                     Type="password"
                     Caption="New password:"
                     Placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                     Value="@ChangePasswordRequestModel.NewPassword1"
                     ValueChanged="@(v => ChangePasswordRequestModel.NewPassword1 = v)"
                     ValueExpression="@(() => ChangePasswordRequestModel.NewPassword1)" />

        <br />
        <br />
        <TextElement Id="newpassword2"
                     Type="password"
                     Caption="Repeat new password:"
                     Placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                     Value="@ChangePasswordRequestModel.NewPassword2"
                     ValueChanged="@(v => ChangePasswordRequestModel.NewPassword2 = v)"
                     ValueExpression="@(() => ChangePasswordRequestModel.NewPassword2)" />
        <br />
        <br />
        <SubmitButton Text="Submit" ProcessingText="Processing..." IsProcessing="IsProcessing" />
        &nbsp;&nbsp;&nbsp;
        <ActionButton Text="Cancel" ProcessingText="Cancelling..." NavigationUrl="/me/profile" ForceLoad="true" />

    </EditForm>
</div>



@code {

    [SupplyParameterFromForm]
    public ChangePasswordRequestModel? ChangePasswordRequestModel { get; set; }

    private bool IsProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        ChangePasswordRequestModel ??= new ChangePasswordRequestModel();
    }

    private async Task HandleSubmit()
    {
        IsProcessing = true;
        var cookies = await _cookiesMasterService.GetAsync();
        ChangePasswordRequestModel!.EmailAddress = cookies!.UserEmailAddressValue;
        var response = await _userUseCase.ExecuteAsync(cookies.TokenValue, ChangePasswordRequestModel!);
        await StopProcessing();
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/me/profile/password", true);
            return;
        }
        await _cookiesMasterService.DeleteCookiesAsync();
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/account/signin", true);
    }

    private async Task StopProcessing()
    {
        IsProcessing = false;
        StateHasChanged();
        await Task.Yield();
    }

}
