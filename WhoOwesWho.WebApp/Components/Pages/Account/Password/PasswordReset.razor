@page "/account/password/reset" 

@inject NavigationManager _nav
@inject IUserUseCase _userUseCase
@inject IAlertService _alertService


<div class="text-center">
    <br />
    <br />
    <h1 class="text-4xl">Reset Password</h1>
    <br />
    <br />
    <p class="text-xl">Enter new password(s)</p>
    <br />
    <br />
    <EditForm method="post" Model="@resetPasswordRequestModel" OnValidSubmit="ResetPassword" FormName="passwordreset" Enhance>
        <DataAnnotationsValidator />
        <label for="newpassword" class="form-label">Authentication Code:</label>
        <br />
        <InputText id="newpassword" type="password" @bind-Value="resetPasswordRequestModel!.NewPassword"
                   placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                   class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => resetPasswordRequestModel.NewPassword)" class="text-danger" />
        <br />
        <br />
        <label for="newpasswordrepeat" class="form-label">Authentication Code:</label>
        <br />
        <InputText id="newpasswordrepeat" type="password" @bind-Value="resetPasswordRequestModel!.NewPasswordRepeat"
                   placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                   class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => resetPasswordRequestModel.NewPasswordRepeat)" class="text-danger" />
        <br />
        <br />
        <SubmitButton Text="Submit" ProcessingText="Processing..." />
        &nbsp;&nbsp;&nbsp;
        <ActionButton Text="Cancel" ProcessingText="Cancelling..." ForceLoad="true" />
    </EditForm>
    <br />
    <br />
</div>


@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "emailAddress")]
    public string EmailAddress { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string Token { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    public ResetPasswordRequestModel? resetPasswordRequestModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        resetPasswordRequestModel ??= new ResetPasswordRequestModel();
        //await VerifyToken();
    }

    private async Task VerifyToken()
    {
        var verificationResponse = await _userUseCase.ExecuteAsync(EmailAddress, Token);
        if (!verificationResponse.Success)
        {
            await _alertService.Error(verificationResponse.Message!);
            _nav.NavigateTo("/account/signin", forceLoad: true);
        }
    }

    private async Task ResetPassword()
    {
        resetPasswordRequestModel!.EmailAddress = EmailAddress;
        var response = await _userUseCase.ExecuteAsync(resetPasswordRequestModel!);
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/account/password/reset", forceLoad: true);
            return;
        }
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/account/signin", forceLoad: true);
    }
}
