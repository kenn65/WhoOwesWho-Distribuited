@page "/account/password/reset"

<div class="text-center px-4 mb-3">

    <div class="my-6 md:my-10">
        <h1 class="text-2xl md:text-4xl">
            Reset Password
        </h1>

        <p class="text-lg md:text-xl mt-4">
            Enter new password(s)
        </p>
    </div>

    <EditForm method="post"
              Model="@ResetPasswordRequestModel"
              OnValidSubmit="HandleSubmit"
              FormName="passwordreset"
              Enhance>

        <DataAnnotationsValidator />

        <div class="mb-6">
            <TextElement Id="newpassword"
                         Type="password"
                         Caption="New password:"
                         Placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                         Value="@ResetPasswordRequestModel!.NewPassword"
                         ValueChanged="@(v => ResetPasswordRequestModel!.NewPassword = v)"
                         ValueExpression="@(() => ResetPasswordRequestModel!.NewPassword)" />
        </div>

        <div class="mb-6">
            <TextElement Id="newpasswordrepeat"
                         Type="password"
                         Caption="Repeat new password:"
                         Placeholder="Your new password containing at least 8 characters, one upper case character and two digits"
                         Value="@ResetPasswordRequestModel!.NewPasswordRepeat"
                         ValueChanged="@(v => ResetPasswordRequestModel!.NewPasswordRepeat = v)"
                         ValueExpression="@(() => ResetPasswordRequestModel!.NewPasswordRepeat)" />
        </div>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-3 mt-10">

            <SubmitButton Text="Submit"
                          ProcessingText="Processing..."
                          IsProcessing="IsProcessing" />

            <ActionButton Text="Cancel"
                          ProcessingText="Cancelling..."
                          ForceLoad="true" />

        </div>

    </EditForm>

</div>