@page "/account/password/forgot"

@inject NavigationManager _nav
@inject IUserUseCase _userUseCase
@inject IAlertService _alertService

<div class="text-center mb-3">
    <br />
    <h1 class="text-4xl">Forgot Password</h1>
    <br />
    <p class="text-xl">
        Please enter your Who Owes Who e-mail address to reset your password.
        <br />
    </p>
    <br />
    <br />
    <p class="text-sm text-italic">
        An e-mail will be sent to you with a link to reset your password.
        <br />
        <strong>Note:</strong> If you do not receive an e-mail, please check
        your spam folder.
    </p>
    <br />
    <br />

    <EditForm method="post" Model="@ForgotPasswordRequestModel" OnValidSubmit="HandleSubmit" FormName="forgotpassword" Enhance>
        <DataAnnotationsValidator />
        <TextElement Id="emailaddress"
                     Type="email"
                     Caption="Email address:"
                     Placeholder="Your e-mail address"
                     Value="@ForgotPasswordRequestModel!.EmailAddress"
                     ValueChanged="@(v => ForgotPasswordRequestModel.EmailAddress = v)"
                     ValueExpression="@(() => ForgotPasswordRequestModel.EmailAddress)" />
        <br />
        <br />
        <SubmitButton Text="Submit"
                      ProcessingText="Processing..."
                      IsProcessing="IsProcessing" />
    </EditForm>
</div>

@code {

    [SupplyParameterFromForm]
    public ForgotPasswordRequestModel? ForgotPasswordRequestModel { get; set; }

    private bool IsProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        ForgotPasswordRequestModel ??= new ForgotPasswordRequestModel();
        var uri = new Uri(_nav.Uri);
        string hostName = $"{uri.Host}:{uri.Port}";
        ForgotPasswordRequestModel!.Host = hostName;
    }

    private async Task HandleSubmit()
    {
        IsProcessing = true;
        StateHasChanged();
        await Task.Yield();
        var response = await _userUseCase.ExecuteAsync(ForgotPasswordRequestModel!);
        await StopProcessing();
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/account/password/forgot", forceLoad: true);
            return;
        }
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/", forceLoad: true);
    }

    private async Task StopProcessing()
    {
        IsProcessing = false;
        StateHasChanged();
        await Task.Yield();
    }
}
