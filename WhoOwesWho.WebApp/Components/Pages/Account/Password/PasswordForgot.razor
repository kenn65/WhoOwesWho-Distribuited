@page "/account/password/forgot"

@inject NavigationManager _nav
@inject IUserUseCase _userUseCase
@inject IAlertService _alertService

<div class="text-center">
    <br />
    <h1 class="text-4xl">Forgot Password</h1>
    <br />
    <p class="text-xl">
        Please enter your Who Owes Who e-mail address to reset your password.
        <br />
    </p>
    <br />
    <br />
    <p class="text-sm text-italic">
        An e-mail will be sent to you with a link to reset your password.
        <br />
        <strong>Note:</strong> If you do not receive an e-mail, please check
        your spam folder.
    </p>
    <br />
    <br />

    <EditForm method="post" Model="@_forgotPasswordRequestModel" OnValidSubmit="HandleSubmit" FormName="forgotpassword" Enhance>
        <DataAnnotationsValidator />
        <label for="emailAddress" class="form-label">Email Address:</label>
        <br />
        <InputText id="emailAddress" type="email" @bind-Value="_forgotPasswordRequestModel!.EmailAddress" placeholder="Your e-mail address" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
        <ValidationMessage For="@(() => _forgotPasswordRequestModel.EmailAddress)" class="text-danger" />
        <br />
        <br />
        <SubmitButton Text="Submit"
                      ProcessingText="Processing..." />
    </EditForm>
</div>

@code {

    [SupplyParameterFromForm]
    public ForgotPasswordRequestModel? _forgotPasswordRequestModel { get; set; }


    protected override async Task OnInitializedAsync()
    {
        _forgotPasswordRequestModel ??= new ForgotPasswordRequestModel();
        var uri = new Uri(_nav.Uri);
        string hostName = $"{uri.Host}:{uri.Port}";
        _forgotPasswordRequestModel!.Host = hostName;
    }

    private async Task HandleSubmit()
    {

        StateHasChanged();
        await Task.Yield();

        var response = await _userUseCase.ExecuteAsync(_forgotPasswordRequestModel!);
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("/account/password/forgot", forceLoad: true);
            return;
        }
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/", forceLoad: true);
    }
}
