@page "/account/password/forgot"

<div class="text-center px-4 mb-3">

    <div class="my-6 md:my-10">

        <h1 class="text-2xl md:text-4xl">
            Forgot Password
        </h1>

        <p class="text-lg md:text-xl mt-4 max-w-2xl mx-auto">
            Please enter your Who Owes Who e-mail address to reset your password.
        </p>

        <p class="text-sm italic mt-6 max-w-2xl mx-auto">
            An e-mail will be sent to you with a link to reset your password.
            <br />
            <strong>Note:</strong> If you do not receive an e-mail, please check your spam folder.
        </p>

    </div>

    <EditForm method="post"
              Model="@ForgotPasswordRequestModel"
              OnValidSubmit="HandleSubmit"
              FormName="forgotpassword"
              Enhance>

        <DataAnnotationsValidator />

        <div class="mb-6">
            <TextElement Id="emailaddress"
                         Type="email"
                         Caption="Email address:"
                         Placeholder="Your e-mail address"
                         Value="@ForgotPasswordRequestModel!.EmailAddress"
                         ValueChanged="@(v => ForgotPasswordRequestModel.EmailAddress = v)"
                         ValueExpression="@(() => ForgotPasswordRequestModel.EmailAddress)" />
        </div>

        <div class="flex justify-center mt-10">
            <SubmitButton Text="Submit"
                          ProcessingText="Processing..."
                          IsProcessing="IsProcessing" />
        </div>

    </EditForm>

</div>