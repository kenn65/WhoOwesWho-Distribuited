@page "/account/signin"


@inject NavigationManager _navigationManager
@inject IAuthorizationUseCase _authorizationUseCase
@inject IConfiguration _configuration
@inject IAlertService _alertService
@inject ICookieClientService _cookieClientService

<div class="text-center">
    <h1 class="text-4xl">Sign in</h1>
    <br />
    <br />
    @if (string.IsNullOrEmpty(_code))
    {
        <EditForm method="post" Model="@_authenticationRequestModel" OnValidSubmit="Authenticate" FormName="signin" Enhance>
            <DataAnnotationsValidator />
            <label for="emailAddress" class="form-label">Email Address:</label>
            <br />
            <InputText id="emailAddress" @bind-Value="_authenticationRequestModel!.EmailAddress" placeholder="Your e-mail address" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
            <ValidationMessage For="@(() => _authenticationRequestModel.EmailAddress)" class="text-danger" />
            <br />
            <br />
            <label for="password" class="form-label">Password:</label>
            <br />
            <InputText type="password" id="password" @bind-Value="_authenticationRequestModel.Password" placeholder="Your password containing at least eight characters including one upper case character and two digits" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
            <ValidationMessage For="@(() => _authenticationRequestModel.Password)" class="text-danger" />
            <br />
            <br />
            <SubmitButton Text="Sign in"
                          ProcessingText="Processing..."
                          IsProcessing="@_isSubmitting" />
        </EditForm>
        <br />
        <br />
        <div >
            <a href="/account/password/forgot" class="text-blue-500 hover:underline">Forgot your password?</a>
        </div>
        <br />
        <br />
        <div>
            <a href="#" class="text-blue-500 hover:underline" @onclick="HandleSignUp">Sign up</a>
        </div>
    }
    else
    {
        <EditForm method="post" Model="@_authenticationCodeRequestModel" OnValidSubmit="Authorize" FormName="code" Enhance>
            <DataAnnotationsValidator />
            <label for="authenticationCode" class="form-label">Authentication Code:</label>
            <br />
            <InputText id="authenticationCode" @bind-Value="_authenticationCodeRequestModel!.Code" placeholder="Enter code sent to your e-mail address" class="shadow appearance-none border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-2/4" />
            <ValidationMessage For="@(() => _authenticationCodeRequestModel.Code)" class="text-danger" />
            <br />
            <br />
            <SubmitButton Text="OK"
                ProcessingText="Processing..."
                IsProcessing="@_isSubmitting" />
            &nbsp;&nbsp;&nbsp;
            <ActionButton Text="Cancel"
                ProcessingText="Cancelling..."
                IsProcessing="@_isProcessing"
                OnClick="@HandleCodeCancel" />
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string _code { get; set; } = "";
    private bool _isSubmitting = false;
    private bool _isProcessing = false;

    [SupplyParameterFromForm]
    public AuthenticationRequestModel? _authenticationRequestModel { get; set; }

    [SupplyParameterFromForm]
    public AuthenticationCodeRequestModel? _authenticationCodeRequestModel { get; set; } 

    public AuthenticationResponseModel _autenticationResponseModel { get; set; } = new();

    protected override void OnInitialized()
    {
        _authenticationRequestModel ??= new AuthenticationRequestModel();
        _authenticationCodeRequestModel ??= new AuthenticationCodeRequestModel();
        var uri = new Uri(_navigationManager.Uri);
        string hostName = $"{uri.Host}:{uri.Port}";
        _authenticationRequestModel!.Host = hostName;
    }

    private async Task Authenticate(EditContext args)
    {
        _isSubmitting = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            _autenticationResponseModel = await _authorizationUseCase.ExecuteAsync(_authenticationRequestModel!);

            if (!_autenticationResponseModel.Success)
            {
                await _alertService.Error(_autenticationResponseModel.Message!);
            }
            else
            {
                _code = _autenticationResponseModel.Code;
                await _alertService.Success(_autenticationResponseModel.Message!);
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Authorize(EditContext args)
    {
        _isSubmitting = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            if (_code != _authenticationCodeRequestModel!.Code)
            {
                await _alertService.Error("Invalid authentication code");
                _navigationManager.NavigateTo("/account/signin", forceLoad: true);
            }
            var requestModel = new AuthorizationRequestModel
            {
                EmailAddress = _authenticationRequestModel!.EmailAddress,
            };
            var response = await _authorizationUseCase.ExecuteAsync(requestModel);
            if (!response.Success)
            {
                await _alertService.Error("An error occurred while signing in. Did you verify your e-mail address (e-mail message)?");
                _navigationManager.NavigateTo("/account/signin", forceLoad: true);
            }
            CookiesResponseModel data = response.Adapt<CookiesResponseModel>();
            await _cookieClientService.SetCookiesAsync(data);
            _navigationManager.NavigateTo("/", forceLoad: true);

        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleCodeCancel()
    {
        try
        {
            _isProcessing = true;
            _navigationManager.NavigateTo("/account/signin", forceLoad: true);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleSignUp()
    {
        try
        {
            _isProcessing = true;
            _navigationManager.NavigateTo("/account/signup", forceLoad: true);
        }
        finally
        {
            _isProcessing = false;
        }
    }
}