@page "/account/signup"

@inject NavigationManager _nav
@inject IUserUseCase _userUseCase
@inject IAlertService _alertService

<div class="text-center mb-3">
    <h1 class="text-4xl">Sign in</h1>
    <br />
    <br />
    <EditForm method="post" Model="@UserModel" OnValidSubmit="HandleSubmit" FormName="signup" Enhance>
        <TextElement Id="fullname"
                     Caption="Full Name:"
                     Placeholder="Your first and last name"
                     Value="@UserModel!.FullName"
                     ValueChanged="@(v => UserModel.FullName = v)"
                     ValueExpression="@(() => UserModel.FullName)" />
        <br />
        <br />
        <TextElement Id="emailaddress"
                     Type="email"
                     Caption="Email Address:"
                     Placeholder="Your e-mail address"
                     Value="@UserModel!.EmailAddress"
                     ValueChanged="@(v => UserModel.EmailAddress = v)"
                     ValueExpression="@(() => UserModel.EmailAddress)" />
        <br />
        <br />
        <TextElement Id="mobilephonenumber"
                     Caption="Mobile Phone Number:"
                     Placeholder="Your mobile phone number"
                     Value="@UserModel!.MobilePhoneNumber"
                     ValueChanged="@(v => UserModel.MobilePhoneNumber = v)"
                     ValueExpression="@(() => UserModel.MobilePhoneNumber)" />
        <br />
        <br />
        <TextElement Id="password"
                     Type="password"
                     Caption="Password:"
                     Placeholder="Your password containing at least eight characters including one upper case character and two digits"
                     Value="@UserModel!.Password"
                     ValueChanged="@(v => UserModel.Password = v)"
                     ValueExpression="@(() => UserModel.Password)" />
        <br />
        <br />
        <label for="administrator" class="form-label">Administrator:</label>
        <br />
        <InputCheckbox id="administrator" @bind-Value="UserModel.Admin" class="shadow border border-gray-700  hover:border-green-700 rounded py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline w-16" />
        <br />
        <br />
        <SubmitButton Text="Sign up"
                      ProcessingText="Processing..."
                      IsProcessing="IsProcessing" />
    </EditForm>
</div>

@code {

    public string Host = string.Empty;
    public bool IsProcessing = false;

    [SupplyParameterFromForm]
    public UserModel? UserModel { get; set; }

    protected override void OnInitialized()
    {
        UserModel ??= new UserModel();
        var uri = new Uri(_nav.Uri);
        Host = $"{uri.Host}:{uri.Port}";
    }

    private async Task HandleSubmit(EditContext args)
    {
        IsProcessing = true;
        StateHasChanged();
        await Task.Yield();

        var requestModel = new SignUpRequestModel
        {
            Entity = UserModel,
            Host = Host
        };
        var response = await _userUseCase.ExecuteAsync(requestModel);
        await StopProcessing();
        if (!response.Success)
        {
            await _alertService.Error(response.Message!);
            _nav.NavigateTo("account/signup", forceLoad: true);
            return;
        }
        await _alertService.Success(response.Message!);
        _nav.NavigateTo("/account/signin", forceLoad: true);
    }

    private async Task StopProcessing()
    {
        IsProcessing = false;
        StateHasChanged();
        await Task.Yield();
    }
}
