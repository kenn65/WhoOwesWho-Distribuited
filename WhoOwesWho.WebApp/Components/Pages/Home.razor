@page "/"

<div class="text-center px-4 mb-3">

    <!-- Header -->
    <div class="my-6 md:my-10">

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold">
            Who Owes Who
        </h1>

        <p class="text-lg md:text-xl mt-4">
            Your group travels loan calculator
        </p>

    </div>

    <hr class="my-6 md:my-8" />

    <!-- Logo -->
    <div class="flex justify-center">

        <img src="wow-logo-big.png"
             alt="Who Owes Who"
             class="w-40 h-40 md:w-52 md:h-52 object-contain" />

    </div>

    <hr class="my-6 md:my-8" />

    <!-- Actions -->
    <div class="w-full md:w-2/4 mx-auto space-y-3">

        <NavigationButton Text="Sign in"
                          ProcessingText="Navigating..."
                          NavigationUrl="/account/signin" />

        <NavigationButton Text="Sign up"
                          ProcessingText="Navigating..."
                          NavigationUrl="/account/signup" />

    </div>

</div>