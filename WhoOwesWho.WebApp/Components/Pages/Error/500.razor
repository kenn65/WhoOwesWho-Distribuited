@page "/error/500"
@inject NavigationManager NavigationManager

<div class="min-h-[70vh] flex items-center justify-center px-4">

    <div class="max-w-2xl w-full text-center">
        <hr class="my-6 md:my-8" />

        <!-- Logo -->
        <div class="flex justify-center">

            <img src="wow-logo-big.png"
                 alt="Who Owes Who"
                 class="w-40 h-40 md:w-52 md:h-52 object-contain" />

        </div>

        <hr class="my-6 md:my-8" />

        <div class="text-6xl mb-6">
            ⚠️
        </div>

        <h1 class="text-3xl md:text-5xl font-bold text-red-700 mb-4">
            Internal Server Error
        </h1>

        <p class="text-lg md:text-xl text-gray-700 mb-8">
            Something unexpected happened while processing your request.
        </p>

        <p class="text-gray-500 mb-8">
            Please try again. If the problem persists, contact support.
        </p>
              

        <div class="flex flex-col sm:flex-row justify-center gap-3">

            <button class="bg-gray-700 hover:bg-black text-white py-2 px-4 rounded"
                    @onclick="GoHome">
                Go to Home
            </button>

            <button class="bg-blue-700 hover:bg-blue-800 text-white py-2 px-4 rounded"
                    @onclick="Refresh">
                Try Again
            </button>

        </div>

    </div>

</div>

@code
{
    private void GoHome()
    {
        NavigationManager.NavigateTo("/", true);
    }

    private void Refresh()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}